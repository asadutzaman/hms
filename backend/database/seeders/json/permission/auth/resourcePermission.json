  },
  "scopes": [
    {
      "scope": "auth:resource:menuAccess",
      "display_name": "Menu Access",
      "actions": [
        {
          "http_method": "GET",
          "action_name": "index",
          "uri": "/resource"
        }
      ]
    },
    {
      "scope": "auth:resource:list",
      "display_name": "List",
      "actions": [
        {
          "http_method": "GET",
          "action_name": "index",
          "uri": "/resource"
        }
      ]
    },
    {
      "scope": "auth:resource:view",
      "display_name": "View",
      "actions": [
        {
          "http_method": "GET",
          "action_name": "show",
          "uri": "/resource/*"
        },
        {
          "http_method": "GET",
          "action_name": "getByWhere",
          "uri": "/resource/getByWhere"
        }
      ]
    },
    {
      "scope": "auth:resource:create",
