{
    "resource": {
        "permission_type": "RESOURCE",
        "name": "shift",
        "display_name": "Shift",
        "resource_uri": "shift",
        "controller_name": "ShiftController",
        "server_url_prefix": "auth",
        "component": "COMMON"
    },
    "scopes": [
        {
            "scope": "auth:shift:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                { "http_method": "GET", "action_name": "index", "uri": "/shift" }
            ]
        },
        {
            "scope": "auth:shift:list",
            "display_name": "List",
            "actions": [
                { "http_method": "GET", "action_name": "index", "uri": "/shift" },
                { "http_method": "GET", "action_name": "dropdown", "uri": "/shift/dropdown" }
            ]
        },
        {
            "scope": "auth:shift:view",
            "display_name": "View",
            "actions": [
                { "http_method": "GET", "action_name": "show", "uri": "/shift/*" }
            ]
        },
        {
            "scope": "auth:shift:create",
            "display_name": "Create",
            "actions": [
                { "http_method": "POST", "action_name": "store", "uri": "/shift" }
            ]
        },
        {
            "scope": "auth:shift:edit",
            "display_name": "Edit",
            "actions": [
                { "http_method": "PUT", "action_name": "update", "uri": "/shift/*" },
                { "http_method": "PATCH", "action_name": "updateFields", "uri": "/shift/*" }
            ]
        },
        {
            "scope": "auth:shift:delete",
            "display_name": "Delete",
            "actions": [
                { "http_method": "DELETE", "action_name": "destroy", "uri": "/shift/*" }
            ]
        },
        {
            "scope": "auth:shift:multiSelect",
            "display_name": "Multiple Selection",
            "actions": [
                { "http_method": "POST", "action_name": "bulk", "uri": "/shift/bulk" }
            ]
        }
    ]
}
