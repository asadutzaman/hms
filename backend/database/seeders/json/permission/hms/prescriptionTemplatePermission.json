{
    "resource": {
        "permission_type": "RESOURCE",
        "name": "prescriptionTemplate",
        "display_name": "Prescription Template",
        "resource_uri": "prescription-template",
        "controller_name": "PrescriptionTemplateController",
        "server_url_prefix": "auth",
        "component": "COMMON"
    },
    "scopes": [
        {
            "scope": "auth:prescriptionTemplate:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/prescription-template"
                }
            ]
        },
        {
            "scope": "auth:prescriptionTemplate:list",
            "display_name": "List",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/prescription-template"
                },
                {
                    "http_method": "GET",
                    "action_name": "dropdown",
                    "uri": "/prescription-template/dropdown"
                },
                {
                    "http_method": "GET",
                    "action_name": "apply",
                    "uri": "/prescription-template/*/apply"
                }
            ]
        },
        {
            "scope": "auth:prescriptionTemplate:view",
            "display_name": "View",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "show",
                    "uri": "/prescription-template/*"
                }
            ]
        },
        {
            "scope": "auth:prescriptionTemplate:create",
            "display_name": "Create",
            "actions": [
                {
                    "http_method": "POST",
                    "action_name": "store",
                    "uri": "/prescription-template"
                }
            ]
        },
        {
            "scope": "auth:prescriptionTemplate:edit",
            "display_name": "Edit",
            "actions": [
                {
                    "http_method": "PUT",
                    "action_name": "update",
                    "uri": "/prescription-template/*"
                },
                {
                    "http_method": "PATCH",
                    "action_name": "updateFields",
                    "uri": "/prescription-template/*"
                }
            ]
        },
        {
            "scope": "auth:prescriptionTemplate:delete",
            "display_name": "Delete",
            "actions": [
                {
                    "http_method": "DELETE",
                    "action_name": "destroy",
                    "uri": "/prescription-template/*"
                }
            ]
        },
        {
            "scope": "auth:prescriptionTemplate:multiSelect",
            "display_name": "Multiple Selection",
            "actions": [
                {
                    "http_method": "POST",
                    "action_name": "bulk",
                    "uri": "/prescription-template/bulk"
                }
            ]
