        "component": "COMMON"
    },
    "scopes": [
        {
            "scope": "auth:drugInteraction:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/drug-interaction"
                }
            ]
        },
        {
            "scope": "auth:drugInteraction:list",
            "display_name": "List",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/drug-interaction"
                },
                {
                    "http_method": "GET",
                    "action_name": "dropdown",
                    "uri": "/drug-interaction/dropdown"
                },
                {
                    "http_method": "POST",
                    "action_name": "check",
                    "uri": "/drug-interaction/check"
                }
            ]
        },
        {
            "scope": "auth:drugInteraction:view",
            "display_name": "View",
            "actions": [
