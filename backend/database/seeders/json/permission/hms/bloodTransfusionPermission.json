            ]
        },
        {
            "scope": "auth:blood-transfusion:list",
            "display_name": "List",
            "actions": [
                { "http_method": "GET", "action_name": "byPatient", "uri": "/blood-transfusion/by-patient/*" }
            ]
        },
        {
