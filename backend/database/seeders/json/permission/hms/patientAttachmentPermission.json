{
    "resource": {
        "permission_type": "RESOURCE",
        "name": "patient-attachment",
        "display_name": "Patient Attachment",
        "resource_uri": "patient-attachment",
        "controller_name": "PatientAttachmentController",
        "server_url_prefix": "auth",
        "component": "COMMON"
    },
    "scopes": [
        {
            "scope": "auth:patient-attachment:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                { "http_method": "GET", "action_name": "byPatient", "uri": "/patient-attachment/by-patient/*" }
            ]
        },
        {
            "scope": "auth:patient-attachment:list",
            "display_name": "List",
            "actions": [
                { "http_method": "GET", "action_name": "byPatient", "uri": "/patient-attachment/by-patient/*" }
            ]
        },
        {
            "scope": "auth:patient-attachment:view",
            "display_name": "View",
            "actions": [
                { "http_method": "GET", "action_name": "show", "uri": "/patient-attachment/*" }
            ]
        },
        {
            "scope": "auth:patient-attachment:create",
            "display_name": "Create",
            "actions": [
                { "http_method": "POST", "action_name": "upload", "uri": "/patient-attachment/upload" }
            ]
        },
        {
            "scope": "auth:patient-attachment:delete",
            "display_name": "Delete",
            "actions": [
                { "http_method": "DELETE", "action_name": "destroy", "uri": "/patient-attachment/*" }
            ]
        }
    ]
}
