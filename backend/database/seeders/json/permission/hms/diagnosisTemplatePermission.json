{
    "resource": {
        "permission_type": "RESOURCE",
        "name": "diagnosisTemplate",
        "display_name": "Diagnosis Template",
        "resource_uri": "diagnosis-template",
        "controller_name": "DiagnosisTemplateController",
        "server_url_prefix": "auth",
        "component": "COMMON"
    },
    "scopes": [
        {
            "scope": "auth:diagnosisTemplate:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/diagnosis-template"
                }
            ]
        },
        {
            "scope": "auth:diagnosisTemplate:list",
            "display_name": "List",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/diagnosis-template"
                },
                {
                    "http_method": "GET",
                    "action_name": "dropdown",
                    "uri": "/diagnosis-template/dropdown"
                },
                {
                    "http_method": "GET",
                    "action_name": "apply",
                    "uri": "/diagnosis-template/*/apply"
                }
            ]
        },
        {
            "scope": "auth:diagnosisTemplate:view",
            "display_name": "View",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "show",
                    "uri": "/diagnosis-template/*"
                }
            ]
        },
        {
            "scope": "auth:diagnosisTemplate:create",
            "display_name": "Create",
            "actions": [
                {
                    "http_method": "POST",
                    "action_name": "store",
                    "uri": "/diagnosis-template"
                }
            ]
        },
        {
            "scope": "auth:diagnosisTemplate:edit",
            "display_name": "Edit",
            "actions": [
                {
                    "http_method": "PUT",
                    "action_name": "update",
                    "uri": "/diagnosis-template/*"
                },
                {
                    "http_method": "PATCH",
                    "action_name": "updateFields",
                    "uri": "/diagnosis-template/*"
                }
            ]
        },
        {
            "scope": "auth:diagnosisTemplate:delete",
            "display_name": "Delete",
            "actions": [
                {
                    "http_method": "DELETE",
                    "action_name": "destroy",
                    "uri": "/diagnosis-template/*"
                }
            ]
        },
        {
            "scope": "auth:diagnosisTemplate:multiSelect",
            "display_name": "Multiple Selection",
            "actions": [
                {
                    "http_method": "POST",
                    "action_name": "bulk",
                    "uri": "/diagnosis-template/bulk"
                }
            ]
        }
    ]
}
