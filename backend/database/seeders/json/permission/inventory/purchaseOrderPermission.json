    },
    "scopes": [
        {
            "scope": "auth:purchaseOrder:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/purchase-order"
                }
            ]
        },
        {
            "scope": "auth:purchaseOrder:list",
            "display_name": "List",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/purchase-order"
                },
                {
                    "http_method": "GET",
                    "action_name": "dropdown",
                    "uri": "/purchase-order/dropdown"
                }
            ]
        },
        {
            "scope": "auth:purchaseOrder:view",
            "display_name": "View",
            "actions": [
                {
                    "http_method": "GET",
