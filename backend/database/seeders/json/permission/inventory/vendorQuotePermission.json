    },
    "scopes": [
        {
            "scope": "auth:vendorQuote:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/vendor-quote"
                }
            ]
        },
        {
            "scope": "auth:vendorQuote:list",
            "display_name": "List",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/vendor-quote"
                },
                {
                    "http_method": "GET",
                    "action_name": "compare",
                    "uri": "/vendor-quote/compare"
                }
            ]
        },
        {
            "scope": "auth:vendorQuote:view",
            "display_name": "View",
            "actions": [
                {
