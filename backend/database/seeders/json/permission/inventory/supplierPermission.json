{
    "resource": {
        "permission_type": "RESOURCE",
        "name": "supplier",
        "display_name": "Back Office Setup - Supplier",
        "resource_uri": "supplier",
        "controller_name": "SupplierController",
        "server_url_prefix": "auth",
        "component": "COMMON"
    },
    "scopes": [
        {
            "scope": "auth:supplier:menuAccess",
            "display_name": "Menu Access",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/supplier"
                }
            ]
        },
        {
            "scope": "auth:supplier:list",
            "display_name": "List",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "index",
                    "uri": "/supplier"
                }
            ]
        },
        {
            "scope": "auth:supplier:view",
            "display_name": "View",
            "actions": [
                {
                    "http_method": "GET",
                    "action_name": "show",
                    "uri": "/supplier/*"
                },
                {
